# watsonx.ai credentials
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_TEXT_MODEL=ibm/granite-3-3-8b-instruct
WATSONX_VISION_MODEL=ibm/granite-vision-3-2-2b
WATSONX_VISION_ENABLED=true

# Risk thresholds
HIGH_RISK_THRESHOLD=0.65
MEDIUM_RISK_THRESHOLD=0.35

# Relevance & look-ahead
MAX_RELEVANCE_DISTANCE_M=500
LOOK_AHEAD_SECONDS=8

# Freshness / expiry (seconds)
FRESHNESS_FULL_SECONDS=10
FRESHNESS_MODERATE_SECONDS=30
HAZARD_EXPIRY_SECONDS=120

# Physics / conflict detection
BRAKING_THRESHOLD_MS2=-4.0
CONFLICT_WINDOW_SECONDS=2.0
MAX_TTC_SECONDS=10.0

# Telemetry rate-limiting
TELEMETRY_RATE_LIMIT_SECONDS=1.0

# Maneuver zone
MANEUVER_ZONE_RADIUS_M=150
